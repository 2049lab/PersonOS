# ═══════════════════════════════════════════════════════════════════════
# REQUIRED — one key is enough to run.
#
# Chat and embeddings both speak the OpenAI wire format, so a single
# endpoint usually serves both. Point this at OpenAI, vLLM, Ollama,
# LiteLLM, or any compatible gateway.
# ═══════════════════════════════════════════════════════════════════════
PERSONOS_LLM_API_KEY=sk-...
# PERSONOS_LLM_BASE_URL=https://api.openai.com/v1
# PERSONOS_LLM_MODEL=gpt-4o-mini
# PERSONOS_EMBEDDING_MODEL=text-embedding-3-small
# PERSONOS_EMBEDDING_DIM=1536

# ═══════════════════════════════════════════════════════════════════════
# OPTIONAL — everything below has a working default.
# Leaving one unset never breaks the text path; it turns off a capability,
# and `personos doctor` will tell you which.
# ═══════════════════════════════════════════════════════════════════════

# ── Storage ────────────────────────────────────────────────────────────
# Default: SQLite under the data directory, tables created automatically.
# PERSONOS_DATA_DIR=~/.personos
#
# MySQL instead (needs `pip install personos[mysql]`). Required if several
# workers share one memory store; SQLite allows a single writer.
# PERSONOS_DB_URL=mysql+pymysql://user:pass@host:3306/personos?charset=utf8mb4

# ── Multimodal ─────────────────────────────────────────────────────────
# Unset: text memory is unaffected. Images are stored but not understood,
# so they contribute nothing to retrieval; video is refused with an error.
# PERSONOS_MLLM_API_KEY=
# PERSONOS_MLLM_MODEL=gpt-4o
# PERSONOS_MLLM_BASE_URL=            # falls back to PERSONOS_LLM_BASE_URL

# ── Media storage ──────────────────────────────────────────────────────
# Default: local files under the data directory.
# PERSONOS_MEDIA_BACKEND=local       # local | oss
#
# Video with local storage needs a publicly reachable URL prefix: the model
# service fetches the clip itself and cannot read a local path.
# PERSONOS_MEDIA_BASE_URL=
#
# Object storage (needs `pip install personos[oss]`):
# OSS_ACCESS_KEY_ID=
# OSS_ACCESS_KEY_SECRET=
# OSS_BUCKET=
# OSS_ENDPOINT=

# ── Reranking ──────────────────────────────────────────────────────────
# Unset: retrieval keeps its fusion order, which is a reasonable ranking.
# Any /rerank endpoint (Cohere, Jina, Voyage, text-embeddings-inference).
# PERSONOS_RERANK_API_KEY=
# PERSONOS_RERANK_MODEL=
# PERSONOS_RERANK_BASE_URL=

# ── Video identity ─────────────────────────────────────────────────────
# Unset: video ingestion is refused with instructions.
# Needs `pip install personos[identity]` — roughly 2 GB of model deps.
# PERSONOS_VIDEO_BACKEND=none        # none | real

# ── Multiple workers ───────────────────────────────────────────────────
# Unset: single process. Segment state, session locks and the ingest queue
# live in memory, so separate workers would not see each other.
# PERSONOS_REDIS_URL=redis://localhost:6379/0
# PERSONOS_ENV=local                 # key namespace, so deployments cannot collide

# ── Tuning ─────────────────────────────────────────────────────────────
# PERSONOS_DEEP_WRITE=1              # let deep recall write new atoms back
# PERSONOS_LOG_DIR=

# ── Advanced: tracing ──────────────────────────────────────────────────
# Unset (the default) means every tracing call is a no-op. Useful when
# running this as a service; unnecessary when embedding the library.
# LANGFUSE_PUBLIC_KEY=
# LANGFUSE_SECRET_KEY=
# LANGFUSE_HOST=https://cloud.langfuse.com
