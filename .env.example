# ═══════════════════════════════════════════════════════════════════════
# REQUIRED — one key is enough to run.
#
# Chat and embeddings both speak the OpenAI wire format, so a single
# endpoint usually serves both. Point this at OpenAI, vLLM, Ollama,
# LiteLLM, or any compatible gateway.
# ═══════════════════════════════════════════════════════════════════════
PERSONOS_LLM_API_KEY=sk-...
# PERSONOS_LLM_BASE_URL=https://api.openai.com/v1
# PERSONOS_LLM_MODEL=gpt-4o-mini
# PERSONOS_EMBEDDING_MODEL=text-embedding-3-small
# PERSONOS_EMBEDDING_DIM=1536

# ═══════════════════════════════════════════════════════════════════════
# OPTIONAL — everything below has a working default.
# Leaving one unset never breaks the text path; it turns off a capability,
# and `personos doctor` will tell you which.
# ═══════════════════════════════════════════════════════════════════════

# ── Storage ────────────────────────────────────────────────────────────
# Default: SQLite under the data directory, tables created automatically.
# PERSONOS_DATA_DIR=~/.personos
#
# MySQL instead (needs `pip install personos[mysql]`). Required if several
# workers share one memory store; SQLite allows a single writer.
# PERSONOS_DB_URL=mysql+pymysql://user:pass@host:3306/personos?charset=utf8mb4

# ── Multimodal ─────────────────────────────────────────────────────────
# Unset: text memory is unaffected. Images are stored but not understood,
# so they contribute nothing to retrieval; video is refused with an error.
# PERSONOS_MLLM_API_KEY=
# PERSONOS_MLLM_MODEL=gpt-4o
# PERSONOS_MLLM_BASE_URL=            # falls back to PERSONOS_LLM_BASE_URL

# ── Media storage ──────────────────────────────────────────────────────
# Default: local files under the data directory.
# PERSONOS_MEDIA_BACKEND=local       # local | oss
#
# Video with local storage needs a publicly reachable URL prefix: the model
# service fetches the clip itself and cannot read a local path.
# PERSONOS_MEDIA_BASE_URL=
#
# Object storage (needs `pip install personos[oss]`):
# PERSONOS_OSS_ACCESS_KEY_ID=
# PERSONOS_OSS_ACCESS_KEY_SECRET=
# PERSONOS_OSS_BUCKET=
# PERSONOS_OSS_ENDPOINT=

# ── Reranking ──────────────────────────────────────────────────────────
# Unset: retrieval keeps its fusion order, which is a reasonable ranking.
# Any /rerank endpoint (Cohere, Jina, Voyage, text-embeddings-inference).
# PERSONOS_RERANK_API_KEY=
# PERSONOS_RERANK_MODEL=
# PERSONOS_RERANK_BASE_URL=

# ── Video identity ─────────────────────────────────────────────────────
# Unset: video ingestion is refused with instructions.
# Needs `pip install personos[identity]` — roughly 2 GB of model deps.
# PERSONOS_VIDEO_BACKEND=none        # none | real

# ── Multiple workers ───────────────────────────────────────────────────
# Unset: single process. Segment state, session locks and the ingest queue
# live in memory, so separate workers would not see each other.
# PERSONOS_REDIS_URL=redis://localhost:6379/0
# PERSONOS_ENV=local                 # key namespace, so deployments cannot collide

# ── Tuning ─────────────────────────────────────────────────────────────
# PERSONOS_DEEP_WRITE=1              # let deep recall write new atoms back
# PERSONOS_LOG_DIR=

# ── Advanced: tracing ──────────────────────────────────────────────────
# Unset (the default) means every tracing call is a no-op. Useful when
# running this as a service; unnecessary when embedding the library.
# LANGFUSE_PUBLIC_KEY=
# LANGFUSE_SECRET_KEY=
# LANGFUSE_HOST=https://cloud.langfuse.com

# ── Advanced: alternative providers ────────────────────────────────────
# Which implementation backs each role, by registry name. Change these only
# to use a provider that is not OpenAI-compatible, or one registered by a
# fork (see personos/providers/registry.py).
# PERSONOS_LLM_PROVIDER=openai         # openai | anthropic
# PERSONOS_EMBEDDER_PROVIDER=openai
# PERSONOS_MLLM_PROVIDER=openai
# PERSONOS_RERANKER_PROVIDER=          # empty = chosen from the rerank settings
#
# Anthropic-protocol chat (needs `pip install personos[anthropic]`). Also
# covers anything speaking the same format, via ANTHROPIC_BASE_URL.
# ANTHROPIC_API_KEY=
# ANTHROPIC_BASE_URL=                  # empty = Anthropic's own endpoint
# ANTHROPIC_MODEL=claude-sonnet-4-20250514

# ── Advanced: separate endpoints per role ──────────────────────────────
# Each falls back to the corresponding PERSONOS_LLM_* value. Set these when
# one provider does chat and another does embeddings — which is common,
# because "OpenAI-compatible" chat is near-universal while embeddings are not.
# PERSONOS_EMBEDDING_BASE_URL=
# PERSONOS_EMBEDDING_API_KEY=
# PERSONOS_MLLM_ENDPOINT=              # full URL, for gateways that do not use /v1
# PERSONOS_LLM_APP_ID=                 # some gateways require an application id header

# ── Advanced: timeouts ─────────────────────────────────────────────────
# Chat is non-streaming with a large max_tokens, so a minute or more is
# normal; embeddings and reranking are fast, and a tight limit there
# surfaces faults early instead of hiding them behind a long wait.
# PERSONOS_LLM_TIMEOUT=120
# PERSONOS_MLLM_TIMEOUT=120
# PERSONOS_IO_TIMEOUT=30

# ── Advanced: object storage details ───────────────────────────────────
# PERSONOS_OSS_REGION=
# PERSONOS_OSS_PREFIX=personos/
# PERSONOS_OSS_URL_EXPIRES_SECONDS=3600

# ── Advanced: server mode only ─────────────────────────────────────────
# The library uses none of these; they tune the HTTP server's queue and
# thread pools. See server/README.md.
# PERSONOS_DB_POOL_SIZE=10
# PERSONOS_DB_MAX_OVERFLOW=20
# PERSONOS_INGEST_POOL=50
# PERSONOS_VIDEO_POOL=8                # one temp clip file per slot; budget disk accordingly
# PERSONOS_RECALL_POOL=30              # recall concurrency gate; MUST stay below the
#                                      # anyio thread pool (40) or it never fires
# PERSONOS_POD_COUNT=1                 # replicas sharing one queue; the global backlog
#                                      # gate is 50 x this (all sessions combined -> 503)
# PERSONOS_PROFILE_POOL=50
# PERSONOS_PROFILE_EP_CHARS=15000      # episode characters that trigger profile consolidation
# PERSONOS_MAX_QUEUE_DEPTH=15          # per-session backlog before /ingest returns 503
# PERSONOS_MAX_DRAIN=5                 # messages per turn before a session yields its slot;
#                                      # MUST stay well below MAX_QUEUE_DEPTH or it never fires
# PERSONOS_MAX_INGEST_RETRIES=5        # failures before a message is treated as poison
# PERSONOS_DISPATCH_TICK=0.05
# PERSONOS_DISPATCH_IDLE_TICK=0.5

# ── Advanced: tracing detail ───────────────────────────────────────────
# LANGFUSE_ENVIRONMENT=                # defaults to PERSONOS_ENV
# LANGFUSE_RELEASE=
